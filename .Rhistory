# Load data
data <- outbreaks::fluH7N9_china_2013
# Clean and prepare data
gender_counts <- data %>%
filter(!is.na(gender), !is.na(province)) %>%
group_by(province, gender) %>%
summarise(count = n(), .groups = "drop")
# Add total counts per province for label placement
gender_totals <- gender_counts %>%
group_by(province) %>%
summarise(total = sum(count), .groups = "drop")
# Plot
ggplot(gender_counts, aes(x = province, y = count, fill = gender)) +
geom_bar(stat = "identity") +
geom_text(data = gender_totals, aes(x = province, y = total + 3, label = total),
inherit.aes = FALSE, fontface = "bold") +
geom_text(aes(label = count), position = position_stack(vjust = 0.5), color = "white") +
scale_fill_manual(values = c("m" = "#6BAED6", "f" = "#9E42F5"), labels = c("Male", "Female")) +
labs(title = "Cases by Province and Gender", x = "", y = "Case Count", fill = "") +
theme_minimal(base_size = 14)
